# Environment variables template

# Google Calendar Batch API
# Rate limit: 500 requests/100 seconds per user
# Recommended: 50 events/batch (max allowed) for efficiency
# With Cloud Tasks: Queue handles rate limiting (preferred)
# With sleep fallback: 10s delay = 50 req/10s = 5 req/s = 500 req/100s
BATCH_API_ENABLED=true
BATCH_API_SIZE=50
BATCH_DELAY_MS=10000
BATCH_THRESHOLD=10

# API authentication (required in production)
# Shared secret every caller must send as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
# Set the same value as BACKEND_API_TOKEN in nextjs/.env.local
API_AUTH_TOKEN=
