<plist version="1.0">
<dict>
  <key>Label</key><string>com.trillium.booking-blocks</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/mini0/code/calendar-merge-service/deploy/booking-blocks/run-watch.sh</string>
